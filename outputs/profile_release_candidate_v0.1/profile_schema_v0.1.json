{
  "$defs": {
    "component": {
      "additionalProperties": false,
      "properties": {
        "component_definition_version": {
          "const": "COMP_TRANSCRIPTOMIC_EVIDENCE_V0.1"
        },
        "component_id": {
          "const": "COMP_TRANSCRIPTOMIC_EVIDENCE"
        },
        "features": {
          "items": {
            "$ref": "#/$defs/feature"
          },
          "maxItems": 22,
          "minItems": 22,
          "type": "array"
        },
        "state": {
          "enum": [
            "CONFLICTING",
            "OBSERVED",
            "MISSING",
            "PARTIAL",
            "NOT_QUERIED"
          ]
        },
        "state_rule_id": {
          "type": "string"
        },
        "state_rule_review_status": {
          "type": "string"
        },
        "state_rule_version": {
          "type": "string"
        }
      },
      "required": [
        "component_id",
        "component_definition_version",
        "state",
        "state_rule_id",
        "state_rule_version",
        "state_rule_review_status",
        "features"
      ],
      "type": "object"
    },
    "feature": {
      "additionalProperties": false,
      "properties": {
        "data_type": {
          "type": "string"
        },
        "feature_id": {
          "type": "string"
        },
        "feature_name": {
          "type": "string"
        },
        "missingness_status": {
          "enum": [
            "OBSERVED",
            "NOT_FOUND",
            "NOT_QUERIED",
            "NOT_APPLICABLE",
            "UNKNOWN"
          ]
        },
        "provenance_links": {
          "items": {
            "$ref": "#/$defs/provenance_link"
          },
          "minItems": 1,
          "type": "array"
        },
        "value": {
          "type": "string"
        }
      },
      "required": [
        "feature_id",
        "feature_name",
        "value",
        "data_type",
        "missingness_status",
        "provenance_links"
      ],
      "type": "object"
    },
    "provenance_link": {
      "additionalProperties": false,
      "properties": {
        "artifact_id": {
          "type": "string"
        },
        "claim_id": {
          "type": "string"
        },
        "dependency_id": {
          "type": "string"
        },
        "evidence_record_id": {
          "type": "string"
        },
        "extraction_rule_id": {
          "type": "string"
        },
        "extractor_version": {
          "type": "string"
        },
        "feature_id": {
          "type": "string"
        },
        "source_id": {
          "type": "string"
        }
      },
      "required": [
        "feature_id",
        "evidence_record_id",
        "claim_id",
        "source_id",
        "artifact_id",
        "dependency_id",
        "extraction_rule_id",
        "extractor_version"
      ],
      "type": "object"
    }
  },
  "$id": "urn:luad-target-dossier:full-target-profile:v0.1",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "One deterministic structural evidence profile; no target evaluation.",
  "properties": {
    "EnsemblID": {
      "pattern": "^ENSG[0-9]+\\.[0-9]+$",
      "type": "string"
    },
    "components": {
      "items": {
        "$ref": "#/$defs/component"
      },
      "maxItems": 1,
      "minItems": 1,
      "type": "array"
    },
    "evidence_snapshot_version": {
      "const": "TASK026_TRANSCRIPTOMIC_FEATURES_SHA256_4014469439ff14d27c451a356cf7711daa7a5331c58326eced2cf96edb298844"
    },
    "generator_version": {
      "const": "FULL_PROFILE_MATERIALIZER_V0.1"
    },
    "partition_strategy_version": {
      "const": "ENSEMBL_SHA256_PREFIX_2_V0.1"
    },
    "profile_id": {
      "pattern": "^PRF_[0-9A-F]{24}$",
      "type": "string"
    },
    "profile_version": {
      "const": "FULL_UNIVERSE_TARGET_EVIDENCE_PROFILE_V0.1"
    },
    "schema_version": {
      "const": "TARGET_EVIDENCE_PROFILE_FULL_SCHEMA_V0.1"
    },
    "universe_ordinal": {
      "maximum": 29606,
      "minimum": 1,
      "type": "integer"
    }
  },
  "required": [
    "profile_id",
    "EnsemblID",
    "universe_ordinal",
    "schema_version",
    "profile_version",
    "evidence_snapshot_version",
    "generator_version",
    "partition_strategy_version",
    "components"
  ],
  "title": "Full-universe Target Evidence Profile schema v0.1",
  "type": "object"
}
