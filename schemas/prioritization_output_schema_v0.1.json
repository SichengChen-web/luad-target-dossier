{
  "$comment": "The schema prohibits numeric scoring, target ordering, confidence or probability estimation, success prediction, recommendation, target quality, and evidence strength.",
  "$defs": {
    "categoryAssignment": {
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "assigned_rule_id": {
                "const": "PRULE_035A_001_PARTIAL_OR_CONFLICTING"
              }
            },
            "required": [
              "assigned_rule_id"
            ]
          },
          "then": {
            "properties": {
              "category": {
                "const": "CATEGORY_C"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "assigned_rule_id": {
                "const": "PRULE_035A_002_ALL_OBSERVED"
              }
            },
            "required": [
              "assigned_rule_id"
            ]
          },
          "then": {
            "properties": {
              "category": {
                "const": "CATEGORY_A"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "assigned_rule_id": {
                "const": "PRULE_035A_003_MIXED_OBSERVED_UNAVAILABLE"
              }
            },
            "required": [
              "assigned_rule_id"
            ]
          },
          "then": {
            "properties": {
              "category": {
                "const": "CATEGORY_B"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "assigned_rule_id": {
                "const": "PRULE_035A_004_ALL_UNAVAILABLE"
              }
            },
            "required": [
              "assigned_rule_id"
            ]
          },
          "then": {
            "properties": {
              "category": {
                "const": "CATEGORY_UNASSIGNED"
              }
            }
          }
        }
      ],
      "properties": {
        "assigned_rule_id": {
          "enum": [
            "PRULE_035A_001_PARTIAL_OR_CONFLICTING",
            "PRULE_035A_002_ALL_OBSERVED",
            "PRULE_035A_003_MIXED_OBSERVED_UNAVAILABLE",
            "PRULE_035A_004_ALL_UNAVAILABLE"
          ],
          "type": "string"
        },
        "category": {
          "enum": [
            "CATEGORY_A",
            "CATEGORY_B",
            "CATEGORY_C",
            "CATEGORY_UNASSIGNED"
          ],
          "type": "string"
        },
        "rule_trace": {
          "items": {
            "$ref": "#/$defs/ruleTraceStep"
          },
          "maxItems": 4,
          "minItems": 4,
          "type": "array"
        }
      },
      "required": [
        "category",
        "assigned_rule_id",
        "rule_trace"
      ],
      "type": "object"
    },
    "componentStateSnapshot": {
      "additionalProperties": false,
      "properties": {
        "component_id": {
          "pattern": "^COMP_[A-Z0-9_]+$",
          "type": "string"
        },
        "component_state": {
          "enum": [
            "OBSERVED",
            "PARTIAL",
            "CONFLICTING",
            "MISSING",
            "NOT_QUERIED"
          ],
          "type": "string"
        },
        "component_version": {
          "pattern": "^COMP_[A-Z0-9_]+_V[0-9]+\\.[0-9]+$",
          "type": "string"
        },
        "limitation_identifiers": {
          "items": {
            "pattern": "^LIM_[A-Z0-9_]+$",
            "type": "string"
          },
          "type": "array",
          "uniqueItems": true
        },
        "source_component_record_id": {
          "minLength": 1,
          "type": "string"
        }
      },
      "required": [
        "component_id",
        "component_version",
        "component_state",
        "source_component_record_id",
        "limitation_identifiers"
      ],
      "type": "object"
    },
    "inputObservation": {
      "additionalProperties": false,
      "properties": {
        "json_pointer": {
          "pattern": "^/component_state_snapshot/[0-9]+/component_state$",
          "type": "string"
        },
        "observed_value": {
          "enum": [
            "OBSERVED",
            "PARTIAL",
            "CONFLICTING",
            "MISSING",
            "NOT_QUERIED"
          ],
          "type": "string"
        }
      },
      "required": [
        "json_pointer",
        "observed_value"
      ],
      "type": "object"
    },
    "ruleTraceStep": {
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "trace_step_ordinal": {
                "const": 1
              }
            },
            "required": [
              "trace_step_ordinal"
            ]
          },
          "then": {
            "properties": {
              "predicate_id": {
                "const": "PPRED_ANY_PARTIAL_OR_CONFLICTING_V0.1"
              },
              "rule_id": {
                "const": "PRULE_035A_001_PARTIAL_OR_CONFLICTING"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "trace_step_ordinal": {
                "const": 2
              }
            },
            "required": [
              "trace_step_ordinal"
            ]
          },
          "then": {
            "properties": {
              "predicate_id": {
                "const": "PPRED_ALL_COMPONENTS_OBSERVED_V0.1"
              },
              "rule_id": {
                "const": "PRULE_035A_002_ALL_OBSERVED"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "trace_step_ordinal": {
                "const": 3
              }
            },
            "required": [
              "trace_step_ordinal"
            ]
          },
          "then": {
            "properties": {
              "predicate_id": {
                "const": "PPRED_MIXED_OBSERVED_AND_UNAVAILABLE_V0.1"
              },
              "rule_id": {
                "const": "PRULE_035A_003_MIXED_OBSERVED_UNAVAILABLE"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "trace_step_ordinal": {
                "const": 4
              }
            },
            "required": [
              "trace_step_ordinal"
            ]
          },
          "then": {
            "properties": {
              "predicate_id": {
                "const": "PPRED_ALL_COMPONENTS_UNAVAILABLE_V0.1"
              },
              "rule_id": {
                "const": "PRULE_035A_004_ALL_UNAVAILABLE"
              }
            }
          }
        }
      ],
      "properties": {
        "input_observations": {
          "items": {
            "$ref": "#/$defs/inputObservation"
          },
          "minItems": 1,
          "type": "array"
        },
        "predicate_id": {
          "enum": [
            "PPRED_ANY_PARTIAL_OR_CONFLICTING_V0.1",
            "PPRED_ALL_COMPONENTS_OBSERVED_V0.1",
            "PPRED_MIXED_OBSERVED_AND_UNAVAILABLE_V0.1",
            "PPRED_ALL_COMPONENTS_UNAVAILABLE_V0.1"
          ],
          "type": "string"
        },
        "predicate_result": {
          "type": "boolean"
        },
        "rule_id": {
          "enum": [
            "PRULE_035A_001_PARTIAL_OR_CONFLICTING",
            "PRULE_035A_002_ALL_OBSERVED",
            "PRULE_035A_003_MIXED_OBSERVED_UNAVAILABLE",
            "PRULE_035A_004_ALL_UNAVAILABLE"
          ],
          "type": "string"
        },
        "trace_step_ordinal": {
          "maximum": 4,
          "minimum": 1,
          "type": "integer"
        }
      },
      "required": [
        "trace_step_ordinal",
        "rule_id",
        "predicate_id",
        "predicate_result",
        "input_observations"
      ],
      "type": "object"
    },
    "sourceSummaryIdentity": {
      "additionalProperties": false,
      "properties": {
        "evidence_summary_content_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "type": "string"
        },
        "evidence_summary_id": {
          "pattern": "^SUM_[A-F0-9]{32}$",
          "type": "string"
        },
        "evidence_summary_schema_version": {
          "const": "EVIDENCE_SUMMARY_SCHEMA_V0.1",
          "type": "string"
        },
        "evidence_summary_version": {
          "const": "EVIDENCE_AGGREGATION_REPRESENTATION_V0.1",
          "type": "string"
        },
        "source_evidence_snapshot_version": {
          "minLength": 1,
          "type": "string"
        },
        "source_landscape_id": {
          "minLength": 1,
          "type": "string"
        }
      },
      "required": [
        "evidence_summary_id",
        "evidence_summary_schema_version",
        "evidence_summary_version",
        "evidence_summary_content_sha256",
        "source_landscape_id",
        "source_evidence_snapshot_version"
      ],
      "type": "object"
    }
  },
  "$id": "urn:luad-target-dossier:prioritization-output-schema:v0.1",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "Closed categorical rule-trace representation derived from one frozen Evidence Summary; categories are explicitly non-ordinal.",
  "properties": {
    "EnsemblID": {
      "pattern": "^ENSG[0-9]+\\.[0-9]+$",
      "type": "string"
    },
    "category_assignment": {
      "$ref": "#/$defs/categoryAssignment"
    },
    "component_state_snapshot": {
      "items": {
        "$ref": "#/$defs/componentStateSnapshot"
      },
      "minItems": 1,
      "type": "array"
    },
    "limitation_identifiers": {
      "items": {
        "pattern": "^LIM_[A-Z0-9_]+$",
        "type": "string"
      },
      "type": "array",
      "uniqueItems": true
    },
    "prioritization_generator_version": {
      "minLength": 1,
      "type": "string"
    },
    "prioritization_output_schema_version": {
      "const": "PRIORITIZATION_OUTPUT_SCHEMA_V0.1",
      "type": "string"
    },
    "prioritization_representation_id": {
      "pattern": "^PRZ_[A-F0-9]{32}$",
      "type": "string"
    },
    "prioritization_representation_version": {
      "const": "TRANSPARENT_PRIORITIZATION_PROTOTYPE_V0.1",
      "type": "string"
    },
    "rule_catalog_version": {
      "const": "PRIORITIZATION_RULE_CATALOG_V0.1",
      "type": "string"
    },
    "source_summary_identity": {
      "$ref": "#/$defs/sourceSummaryIdentity"
    },
    "universe_ordinal": {
      "minimum": 1,
      "type": "integer"
    }
  },
  "required": [
    "EnsemblID",
    "universe_ordinal",
    "prioritization_representation_id",
    "prioritization_output_schema_version",
    "prioritization_representation_version",
    "rule_catalog_version",
    "prioritization_generator_version",
    "source_summary_identity",
    "component_state_snapshot",
    "limitation_identifiers",
    "category_assignment"
  ],
  "title": "Transparent Prioritization Prototype output schema v0.1",
  "type": "object"
}
