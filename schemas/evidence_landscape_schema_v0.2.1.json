      "type": "string"
    },
    "landscape_schema_version": {
      "const": "EVIDENCE_LANDSCAPE_SCHEMA_V0.2.1"
    },
    "landscape_version": {
      "const": "MULTI_COMPONENT_EVIDENCE_LANDSCAPE_V0.2"
    },
    "limitation_references": {
      "items": {
