{
  "$comment": "Forward-only compatibility patch for ordered dependency relationships and source-native artifact namespaces. No landscape payload is authorized or generated.",
  "$defs": {
    "artifact_reference": {
      "additionalProperties": false,
      "properties": {
        "artifact_id": {
          "description": "Source-native artifact identifier preserved byte-for-byte.",
          "minLength": 1,
          "type": "string"
        },
        "artifact_namespace": {
          "description": "Source-native identifier namespace; it does not replace artifact_id.",
          "minLength": 1,
          "type": "string"
        },
        "artifact_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "type": "string"
        },
        "storage_reference": {
          "minLength": 1,
          "type": "string"
        }
      },
      "required": [
        "artifact_id",
        "artifact_namespace",
        "artifact_sha256"
      ],
      "type": "object"
    },
    "dependency_reference": {
      "additionalProperties": false,
      "properties": {
        "dependency_id": {
          "minLength": 1,
          "type": "string"
        },
        "dependency_model_version": {
          "minLength": 1,
          "type": "string"
        },
        "dependency_reference_status": {
          "enum": [
            "LINKED_GOVERNED_DEPENDENCY",
            "CONTROLLED_SENTINEL"
          ],
          "type": "string"
        },
        "dependency_relationships": {
          "description": "Lossless ordered relationship classifications for one evidence relationship.",
          "items": {
            "$ref": "#/$defs/dependency_relationship"
          },
          "minItems": 1,
          "type": "array",
          "uniqueItems": true
        },
        "governing_artifact_reference": {
          "$ref": "#/$defs/artifact_reference"
        },
        "review_status": {
          "minLength": 1,
          "type": "string"
        }
      },
      "required": [
        "dependency_id",
        "dependency_reference_status",
        "dependency_relationships",
        "dependency_model_version",
        "governing_artifact_reference",
        "review_status"
      ],
      "type": "object"
    },
    "dependency_relationship": {
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "relationship_type": {
                "const": "SAME_SOURCE"
              }
            },
            "required": [
              "relationship_type"
            ]
          },
          "then": {
            "properties": {
              "dependency_level": {
                "const": "DEPENDENT"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "relationship_type": {
                "const": "SHARED_DATASET"
              }
            },
            "required": [
              "relationship_type"
            ]
          },
          "then": {
            "properties": {
              "dependency_level": {
                "const": "DEPENDENT"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "relationship_type": {
                "const": "PARTIAL"
              }
            },
            "required": [
              "relationship_type"
            ]
          },
          "then": {
            "properties": {
              "dependency_level": {
                "const": "PARTIALLY_DEPENDENT"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "relationship_type": {
                "const": "UNKNOWN"
              }
            },
            "required": [
              "relationship_type"
            ]
          },
          "then": {
            "properties": {
              "dependency_level": {
                "const": "UNKNOWN"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "relationship_type": {
                "const": "INDEPENDENT"
              }
            },
            "required": [
              "relationship_type"
            ]
          },
          "then": {
            "properties": {
              "dependency_level": {
                "const": "INDEPENDENT"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "relationship_type": {
                "const": "NOT_APPLICABLE"
              }
            },
            "required": [
              "relationship_type"
            ]
          },
          "then": {
            "properties": {
              "dependency_level": {
                "const": "NOT_APPLICABLE"
              }
            }
          }
        }
      ],
      "properties": {
        "dependency_level": {
          "enum": [
            "DEPENDENT",
            "PARTIALLY_DEPENDENT",
            "UNKNOWN",
            "INDEPENDENT",
            "NOT_APPLICABLE"
          ],
          "type": "string"
        },
        "relationship_type": {
          "enum": [
            "SAME_SOURCE",
            "SHARED_DATASET",
            "PARTIAL",
            "UNKNOWN",
            "INDEPENDENT",
            "NOT_APPLICABLE"
          ],
          "type": "string"
        }
      },
      "required": [
        "relationship_type",
        "dependency_level"
      ],
      "type": "object"
    },
