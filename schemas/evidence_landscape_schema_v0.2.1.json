  "$id": "urn:luad-target-dossier:evidence-landscape-schema:v0.2.1",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "Strict structural contract for a deterministic projection of one frozen Task #032C multi-component Target Evidence Profile.",
  "properties": {
    "EnsemblID": {
      "description": "Immutable, versioned Ensembl gene identifier.",
      "pattern": "^ENSG[0-9]+\\.[0-9]+$",
      "type": "string"
